---
import { Image } from "astro:assets";
import farmIcon from "../../icons/SheepTag2_Icon_96x96.png";
import { LINKS, withUtm, type LinkPlacement } from "../data/links";
import { NAV_SECTIONS, SECTION_GROUPS, sectionHref } from "../data/guides";
import Icon from "./Icon.astro";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

// Home leads and Guides closes the internal set, rendered by hand for its section menu.
const internal = [
  { href: "/terrains", label: "Terrains" },
  { href: "/presskit", label: "Press Kit" },
];
// Kickstarter funded back in 2021 — it lives on in the footer socials and the press kit
// rather than taking a slot in the primary nav.
// Both navs render this set, so the placement tag is applied per nav rather than baked in.
const external = (placement: LinkPlacement) => [
  { href: withUtm(LINKS.soundtrack, placement), label: "Soundtrack" },
  { href: LINKS.discord, label: "Discord" },
];

const guideGroups = SECTION_GROUPS.map((group) => ({
  group,
  items: NAV_SECTIONS.filter((s) => s.group === group),
}));
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="Sheep Tag 2 — home">
      <Image
        src={farmIcon}
        alt=""
        class="brand-logo"
        width={44}
        height={44}
        densities={[2]}
        loading="eager"
      />
    </a>

    <nav class="nav nav-desktop" aria-label="Primary">
      <a href="/" class:list={["nav-link", { active: isActive("/") }]}>Home</a>
      {
        internal.map((l) => (
          <a href={l.href} class:list={["nav-link", { active: isActive(l.href) }]}>
            {l.label}
          </a>
        ))
      }

      <div class="nav-item has-menu">
        <a href="/guides" class:list={["nav-link", { active: isActive("/guides") }]}>
          Guides
          <Icon name="chevronDown" size={14} class="menu-chev" />
        </a>
        <div class="mega" role="group" aria-label="Guide sections">
          <div class="mega-inner">
            {
              guideGroups.map(({ group, items }) => (
                <div class="mega-col">
                  <p class="mega-label">{group}</p>
                  <ul>
                    {items.map((s) => (
                      <li>
                        <a
                          href={sectionHref(s)}
                          class:list={["mega-link", { active: path === sectionHref(s) }]}
                        >
                          {s.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      {
        external("header").map((l) => (
          <a href={l.href} class="nav-link" target="_blank" rel="noopener">
            {l.label}
            <Icon name="external" size={14} class="ext-ico" />
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a
        href={withUtm(LINKS.wishlist, "header")}
        class="btn btn--primary btn--sm wishlist"
        target="_blank"
        rel="noopener"
      >
        <Icon name="steam" size={16} /> Wishlist
      </a>
      <button
        type="button"
        class="hamburger"
        id="nav-toggle"
        aria-label="Open menu"
        aria-controls="mobile-nav"
        aria-expanded="false"
      >
        <Icon name="menu" size={26} />
      </button>
    </div>
  </div>

  <nav class="nav-mobile" id="mobile-nav" aria-label="Primary (mobile)" hidden>
    <div class="wrap nav-mobile-inner">
      <a href="/" class="mobile-link">Home</a>
      {internal.map((l) => <a href={l.href} class="mobile-link">{l.label}</a>)}
      <a href="/guides" class="mobile-link">Guides</a>
      <ul class="mobile-sub">
        {
          NAV_SECTIONS.map((s) => (
            <li>
              <a href={sectionHref(s)} class="mobile-sublink">
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
      {
        external("nav_mobile").map((l) => (
          <a href={l.href} class="mobile-link" target="_blank" rel="noopener">
            {l.label}
            <Icon name="external" size={16} />
          </a>
        ))
      }
      <a
        href={withUtm(LINKS.wishlist, "nav_mobile")}
        class="btn btn--primary mobile-wishlist"
        target="_blank"
        rel="noopener"
      >
        <Icon name="steam" size={16} /> Wishlist on Steam
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--st-bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--st-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--st-header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand-logo {
    height: 44px;
    width: 44px;
    transition: transform 0.16s ease;
  }
  .brand:hover .brand-logo {
    transform: scale(1.08) rotate(-3deg);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.5vw, 1.4rem);
  }
  .nav-desktop {
    margin-left: auto;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.98rem;
    color: var(--st-ink);
    text-decoration: none;
    padding: 0.4em 0.2em;
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover {
    color: var(--st-green-bright);
  }
  .nav-link.active {
    color: var(--st-green-bright);
    border-bottom-color: var(--st-green);
  }
  .ext-ico {
    opacity: 0.55;
  }

  /* Guides mega menu ---------------------------------------------------- */
  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .menu-chev {
    opacity: 0.6;
    transition: rotate 0.15s ease;
  }
  .mega {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0;
    padding-top: 0.65rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.14s ease, translate 0.14s ease;
  }
  .mega-inner {
    display: flex;
    gap: 1.6rem;
    padding: 1rem 1.25rem;
    background: var(--st-surface);
    border: 1px solid var(--st-border);
    border-radius: var(--st-radius);
    box-shadow: var(--st-shadow-lg);
  }
  .mega-label {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--st-ink-subtle);
    margin-bottom: 0.35rem;
  }
  .mega ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mega-link {
    display: block;
    padding: 0.28rem 0.5rem;
    margin-inline: -0.5rem;
    border-radius: 8px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--st-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .mega-link:hover {
    background: var(--st-surface-hover);
    color: var(--st-green-bright);
  }
  .mega-link.active {
    color: var(--st-green-bright);
  }
  /* Pointer or keyboard — the panel opens either way, and Escape closes it. */
  @media (hover: hover) {
    .nav-item.has-menu:hover .mega {
      opacity: 1;
      visibility: visible;
      translate: -50% 2px;
    }
    .nav-item.has-menu:hover .menu-chev {
      rotate: 180deg;
    }
  }
  .nav-item.has-menu:focus-within .mega {
    opacity: 1;
    visibility: visible;
    translate: -50% 2px;
  }
  .nav-item.has-menu.closed .mega {
    opacity: 0;
    visibility: hidden;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }
  .nav-desktop + .header-actions {
    margin-left: 0;
  }
  .hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    color: var(--st-ink);
    cursor: pointer;
  }
  .nav-mobile {
    border-top: 1px solid var(--st-border);
    background: var(--st-bg-2);
    max-height: calc(100dvh - var(--st-header-h));
    overflow-y: auto;
  }
  .nav-mobile-inner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 0.75rem 1.25rem;
  }
  .mobile-link {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.15rem;
    color: var(--st-ink);
    text-decoration: none;
    padding: 0.7em 0.2em;
    border-bottom: 1px solid var(--st-border);
  }
  .mobile-sub {
    list-style: none;
    margin: 0.2rem 0 0.5rem;
    padding: 0 0 0 0.9rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.1rem 0.8rem;
    border-left: 2px solid var(--st-border);
  }
  .mobile-sublink {
    display: block;
    padding: 0.45em 0.2em;
    font-family: var(--font-display);
    font-size: 0.98rem;
    color: var(--st-ink-muted);
    text-decoration: none;
  }
  .mobile-sublink:hover {
    color: var(--st-green-bright);
  }
  .mobile-wishlist {
    margin-top: 0.9rem;
    align-self: flex-start;
  }

  @media (max-width: 1080px) {
    .nav-desktop {
      display: none;
    }
    .hamburger {
      display: inline-flex;
    }
  }
  @media (min-width: 1081px) {
    .nav-mobile {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      document.body.style.overflow = open ? "hidden" : "";
    };
    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => setOpen(false)),
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true")
        setOpen(false);
    });
  }

  // The Guides panel opens on hover and on keyboard focus, both from CSS. Escape has to
  // force it shut, and the class is dropped again as soon as the pointer or focus leaves.
  const guides = document.querySelector<HTMLElement>(".nav-item.has-menu");
  if (guides) {
    const reopen = () => guides.classList.remove("closed");
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      guides.classList.add("closed");
      (document.activeElement as HTMLElement | null)?.blur();
    });
    guides.addEventListener("mouseleave", reopen);
    guides.addEventListener("focusout", (e) => {
      if (!guides.contains(e.relatedTarget as Node | null)) reopen();
    });
  }
</script>
