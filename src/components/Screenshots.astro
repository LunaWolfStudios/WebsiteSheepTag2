---
/**
 * Home-page screenshot gallery (WEBSITE_PROPOSAL.md §6 — Steam-style).
 *
 * Stage carousel (one shot at a time, native scroll-snap so touch swipe works
 * for free) + a thumbnail filmstrip. The enlarge button opens a full-screen
 * <dialog> viewer with arrow buttons, ←/→/Home/End keys, swipe and pinch-zoom.
 *
 * Enlarging is deliberately on its own button rather than the whole frame: on
 * a phone the stage is also the swipe surface, so a tap-anywhere target turns
 * every hesitant swipe into an accidental full-screen. Pointers that can hover
 * have no such conflict, so there the whole frame stays clickable.
 *
 * The viewer reuses the stage's `srcset` with `sizes="100vw"`, so the browser
 * picks a bigger candidate for full-screen than it downloaded for the stage —
 * no second set of derivatives, no extra bytes until someone enlarges a shot.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import { SCREENSHOTS } from "../data/screenshots";

const modules = import.meta.glob<ImageMetadata>("../../screenshots/*.png", {
  eager: true,
  import: "default",
});
const byFile: Record<string, ImageMetadata> = {};
for (const [p, img] of Object.entries(modules)) {
  const file = p.split("/").pop();
  if (file) byFile[file] = img;
}

const shots = SCREENSHOTS.map((s) => {
  const img = byFile[s.file];
  if (!img) throw new Error(`Screenshot "${s.file}" is listed in src/data/screenshots.ts but missing from screenshots/`);
  return { ...s, img };
});

// Stage tops out around 1136px (--st-maxw minus the wrap padding); the wider
// candidates exist for the full-screen viewer and high-DPI screens.
const STAGE_WIDTHS = [768, 1280, 1920, 2560];
const STAGE_SIZES = "(max-width: 1264px) 100vw, 1136px";
---

<section class="section shots" id="screenshots" aria-labelledby="shots-title">
  <div class="wrap">
    <header class="shots-head">
      <h2 id="shots-title">Screenshots</h2>
    </header>

    <div class="shots-stage">
      <ul
        class="shots-track"
        id="shots-track"
        role="group"
        aria-roledescription="carousel"
        aria-label="Sheep Tag 2 screenshots"
      >
        {
          shots.map((s, i) => (
            <li
              class="shot"
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${shots.length}`}
            >
              <div class="shot-frame" data-caption={s.caption}>
                <Image
                  src={s.img}
                  alt={s.alt}
                  class="shot-img"
                  widths={STAGE_WIDTHS}
                  sizes={STAGE_SIZES}
                  loading="lazy"
                  decoding="async"
                  draggable={false}
                />
                <button
                  type="button"
                  class="shot-zoom"
                  aria-label={`Enlarge screenshot ${i + 1} of ${shots.length}: ${s.caption}`}
                >
                  <Icon name="expand" size={18} />
                </button>
              </div>
            </li>
          ))
        }
      </ul>

      <button type="button" class="stage-arrow prev" id="shots-prev" aria-label="Previous screenshot">
        <Icon name="chevronLeft" size={30} />
      </button>
      <button type="button" class="stage-arrow next" id="shots-next" aria-label="Next screenshot">
        <Icon name="chevronRight" size={30} />
      </button>
      <p class="stage-counter" id="shots-counter" aria-hidden="true">1 / {shots.length}</p>
    </div>

    <p class="shots-caption" id="shots-caption" aria-live="polite">{shots[0].caption}</p>

    <ul class="shots-thumbs" id="shots-thumbs" aria-label="Choose a screenshot">
      {
        shots.map((s, i) => (
          <li>
            <button
              type="button"
              class="thumb"
              aria-label={`Show screenshot ${i + 1}: ${s.caption}`}
              aria-current={i === 0 ? "true" : undefined}
            >
              <Image
                src={s.img}
                alt=""
                class="thumb-img"
                width={132}
                height={74}
                densities={[2]}
                loading="lazy"
              />
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<dialog id="shots-viewer" class="viewer" aria-label="Screenshot viewer">
  <div class="viewer-inner">
    <figure class="viewer-figure">
      <div class="viewer-stage" id="viewer-stage">
        <img id="viewer-img" class="viewer-img" alt="" sizes="100vw" draggable="false" />
      </div>
      <figcaption class="viewer-bar">
        <span class="viewer-caption" id="viewer-caption"></span>
        <span class="viewer-counter" id="viewer-counter"></span>
      </figcaption>
    </figure>

    <button type="button" class="viewer-arrow prev" id="viewer-prev" aria-label="Previous screenshot">
      <Icon name="chevronLeft" size={34} />
    </button>
    <button type="button" class="viewer-arrow next" id="viewer-next" aria-label="Next screenshot">
      <Icon name="chevronRight" size={34} />
    </button>
    <button type="button" class="viewer-close" id="viewer-close" aria-label="Close viewer">
      <Icon name="close" size={26} />
    </button>
  </div>
</dialog>

<style>
  .shots {
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--st-green-deep) 18%, transparent), transparent 62%),
      var(--st-bg-2);
    border-top: 1px solid var(--st-border);
    border-bottom: 1px solid var(--st-border);
  }
  .shots-head {
    text-align: center;
    margin-bottom: clamp(1.4rem, 3vw, 2.2rem);
  }
  .shots-head h2 {
    font-size: clamp(1.7rem, 1.2rem + 1.6vw, 2.4rem);
  }

  /* Stage ------------------------------------------------------------- */
  .shots-stage {
    position: relative;
    border-radius: var(--st-radius-lg);
    overflow: hidden;
    background: #0b0d08;
    border: 1px solid var(--st-border);
    box-shadow: var(--st-shadow-lg);
  }
  .shots-track {
    position: relative; /* offsetParent for the slides — the script measures against it */
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .shots-track::-webkit-scrollbar {
    display: none;
  }
  .shot {
    flex: 0 0 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }
  .shot-frame {
    position: relative;
    line-height: 0;
  }
  .shot-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    -webkit-user-drag: none;
  }
  /* Enlarge button — always legible on touch, brightens on hover/focus. */
  .shot-zoom {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgba(244, 239, 225, 0.18);
    border-radius: 50%;
    background: rgba(8, 10, 6, 0.62);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    color: var(--st-ink);
    cursor: zoom-in;
    opacity: 0.85;
    transition: opacity 0.15s ease, background-color 0.15s ease, transform 0.15s ease;
  }
  .shot-zoom:hover,
  .shot-zoom:focus-visible {
    opacity: 1;
    background: rgba(8, 10, 6, 0.85);
    transform: scale(1.08);
  }
  /* Only a pointer that can hover gets tap-anywhere-to-enlarge; on touch that
     target overlaps the swipe surface. */
  @media (hover: hover) and (pointer: fine) {
    .shot-frame {
      cursor: zoom-in;
    }
  }

  .stage-arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(244, 239, 225, 0.18);
    border-radius: 50%;
    background: rgba(8, 10, 6, 0.55);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    color: var(--st-ink);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }
  .stage-arrow.prev {
    left: 0.85rem;
  }
  .stage-arrow.next {
    right: 0.85rem;
  }
  .stage-arrow:hover {
    background: rgba(8, 10, 6, 0.85);
    color: var(--st-green-bright);
    transform: translateY(0) scale(1.06);
  }
  .stage-counter {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    padding: 0.25em 0.7em;
    border-radius: var(--st-radius-pill);
    background: rgba(8, 10, 6, 0.65);
    color: var(--st-ink);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  /* Tall enough for the longest caption at this width, so swapping shots
     never shoves the filmstrip up and down. */
  .shots-caption {
    margin-top: 0.9rem;
    text-align: center;
    color: var(--st-ink-muted);
    text-wrap: pretty;
    min-height: 1.6em;
  }

  /* Filmstrip --------------------------------------------------------- */
  .shots-thumbs {
    display: flex;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0.15rem 0.15rem 0.6rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--st-border) transparent;
    /* `safe` so the first thumbs stay reachable once the strip overflows;
       browsers without it fall back to flex-start, which is the same guarantee. */
    justify-content: safe center;
  }
  /* Without this the thumbs shrink to fit instead of overflowing — and a
     filmstrip that never scrolls is just nine slivers. */
  .shots-thumbs > li {
    flex: 0 0 auto;
  }
  .thumb {
    display: block;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 10px;
    background: none;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.5;
    line-height: 0;
    transition: opacity 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  /* Sized so the current set fits the 1200px wrap without a scrollbar; the
     strip still scrolls once more shots are added. */
  .thumb-img {
    width: 112px;
    height: 63px;
    object-fit: cover;
    border-radius: 8px;
  }
  .thumb:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }
  .thumb[aria-current="true"] {
    opacity: 1;
    border-color: var(--st-gold);
  }

  /* Full-screen viewer ------------------------------------------------ */
  /* Full-bleed: `dialog:modal` is already fixed at inset 0, so 100% fills the
     viewport. `margin: 0` overrides the global `dialog { margin: auto }`. */
  .viewer {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--st-ink);
    overflow: hidden;
  }
  .viewer::backdrop {
    background: rgba(4, 6, 3, 0.94);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  /* The global dialog entrance nudges upward; a full-screen viewer wants a
     straight zoom instead. */
  @media (prefers-reduced-motion: no-preference) {
    .viewer[open] {
      animation: viewer-in 0.2s ease-out;
    }
    @keyframes viewer-in {
      from {
        opacity: 0;
        transform: scale(0.97);
      }
    }
  }
  .viewer-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: clamp(0.75rem, 3vw, 2.5rem);
    /* Clicks that miss the figure fall through to the dialog's close handler. */
  }
  .viewer-figure {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    max-width: min(100%, calc((100dvh - 9rem) * 16 / 9));
  }
  /* The script owns every gesture in here — pinch, pan, double-tap and swipe —
     so the browser must not also pan the page or run its own double-tap zoom.
     Without `touch-action: none` a pinch scrolls the page out from under the
     fingers and the pan turns into a swipe to the next shot. */
  .viewer-stage {
    position: relative;
    overflow: hidden;
    border-radius: var(--st-radius);
    background: #000;
    box-shadow: var(--st-shadow-lg);
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    cursor: zoom-in;
  }
  .viewer-stage.is-zoomed {
    cursor: grab;
  }
  .viewer-img {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
    transform-origin: 50% 50%;
    will-change: transform;
    -webkit-user-drag: none;
  }
  .viewer-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.2rem;
  }
  .viewer-caption {
    color: var(--st-ink-muted);
    text-wrap: pretty;
  }
  .viewer-counter {
    flex-shrink: 0;
    font-family: var(--font-display);
    color: var(--st-ink-subtle);
    font-variant-numeric: tabular-nums;
  }

  .viewer-arrow,
  .viewer-close {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(244, 239, 225, 0.16);
    border-radius: 50%;
    background: rgba(20, 24, 15, 0.72);
    color: var(--st-ink);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }
  .viewer-arrow:hover,
  .viewer-close:hover {
    background: var(--st-surface-hover);
    color: var(--st-green-bright);
  }
  .viewer-arrow {
    top: 50%;
    translate: 0 -50%;
    width: 56px;
    height: 56px;
  }
  .viewer-arrow.prev {
    left: clamp(0.5rem, 2vw, 1.75rem);
  }
  .viewer-arrow.next {
    right: clamp(0.5rem, 2vw, 1.75rem);
  }
  .viewer-close {
    top: clamp(0.5rem, 2vw, 1.5rem);
    right: clamp(0.5rem, 2vw, 1.5rem);
    width: 46px;
    height: 46px;
  }
  .viewer-close:hover {
    transform: rotate(90deg);
  }

  @media (max-width: 700px) {
    .thumb-img {
      width: 104px;
      height: 58px;
    }
    .stage-arrow {
      width: 42px;
      height: 42px;
    }
    .stage-arrow.prev {
      left: 0.5rem;
    }
    .stage-arrow.next {
      right: 0.5rem;
    }
    /* Captions wrap to two lines down here; reserve both so the strip below
       does not jump every time the shot changes. */
    .shots-caption {
      min-height: 3.2em;
    }
    .viewer-arrow {
      width: 44px;
      height: 44px;
    }
    .viewer-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
    /* The bar sits under a vertically centred figure, so a caption that wraps
       to a second line would nudge the shot itself up and down between presses. */
    .viewer-caption {
      min-height: 3.2em;
    }
    .viewer-figure {
      max-width: min(100%, calc((100dvh - 11rem) * 16 / 9));
    }
    .viewer-img {
      max-height: calc(100dvh - 11rem);
    }
  }
</style>

<script>
  const track = document.getElementById("shots-track");
  const viewer = document.getElementById("shots-viewer") as HTMLDialogElement | null;
  const viewerImg = document.getElementById("viewer-img") as HTMLImageElement | null;
  const viewerStage = document.getElementById("viewer-stage");

  if (track && viewer && viewerImg && viewerStage) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>(".shot"));
    const frames = Array.from(track.querySelectorAll<HTMLElement>(".shot-frame"));
    const zoomBtns = Array.from(track.querySelectorAll<HTMLButtonElement>(".shot-zoom"));
    const stageImgs = Array.from(track.querySelectorAll<HTMLImageElement>(".shot-img"));
    const thumbsEl = document.getElementById("shots-thumbs")!;
    const thumbs = Array.from(thumbsEl.querySelectorAll<HTMLButtonElement>(".thumb"));
    const captionEl = document.getElementById("shots-caption")!;
    const counterEl = document.getElementById("shots-counter")!;
    const viewerCaption = document.getElementById("viewer-caption")!;
    const viewerCounter = document.getElementById("viewer-counter")!;
    const total = slides.length;

    const captions = frames.map((f) => f.dataset.caption ?? "");

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const behavior = (): ScrollBehavior => (reduced.matches ? "auto" : "smooth");
    const wrap = (i: number) => (i + total) % total;
    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

    let index = 0;

    // Slide geometry is cached so the scroll handler reads no layout at all.
    let centres: number[] = [];
    let trackWidth = 0;
    const measure = () => {
      trackWidth = track.clientWidth;
      centres = slides.map((el) => el.offsetLeft + el.offsetWidth / 2);
    };
    measure();
    new ResizeObserver(measure).observe(track);

    /** Nearest slide to the middle of the viewport — survives gaps and rubber-banding. */
    const indexFromScroll = () => {
      const mid = track.scrollLeft + trackWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      centres.forEach((c, i) => {
        const dist = Math.abs(c - mid);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      });
      return best;
    };

    const centerIn = (container: HTMLElement, el: HTMLElement, how: ScrollBehavior) => {
      const left = el.offsetLeft - (container.clientWidth - el.offsetWidth) / 2;
      container.scrollTo({ left, behavior: how });
    };

    // A programmatic scroll fires dozens of scroll events, and mandatory snap
    // makes the nearest-slide reading wobble as the animation lands. Feeding
    // that back into the caption is what made the text flicker on every press,
    // so scroll is ignored until the animation has settled. A finger on the
    // track always wins — it releases the hold immediately.
    let settleTimer = 0;
    const releaseStage = () => {
      clearTimeout(settleTimer);
      settleTimer = 0;
    };
    const holdStage = (how: ScrollBehavior) => {
      clearTimeout(settleTimer);
      settleTimer = window.setTimeout(releaseStage, how === "auto" ? 150 : 700);
    };
    track.addEventListener("scrollend", releaseStage);
    track.addEventListener("pointerdown", releaseStage, { passive: true });
    track.addEventListener("touchstart", releaseStage, { passive: true });

    const setIndex = (i: number) => {
      index = i;
      captionEl.textContent = captions[i];
      counterEl.textContent = `${i + 1} / ${total}`;
      thumbs.forEach((t, n) =>
        n === i ? t.setAttribute("aria-current", "true") : t.removeAttribute("aria-current"),
      );
      centerIn(thumbsEl, thumbs[i], behavior());
      if (viewer.open) syncViewer();
    };

    // While the viewer is open the stage stays put: scrolling it underneath
    // fed its own scroll events back into setIndex, which re-ran syncViewer
    // mid-animation and made the full-screen shot flash between neighbours.
    // The stage catches up in one instant jump when the viewer closes.
    const goTo = (i: number, how: ScrollBehavior = behavior()) => {
      setIndex(i);
      if (!viewer.open) {
        holdStage(how);
        centerIn(track, slides[i], how);
      }
    };

    // Wrapping around would otherwise smooth-scroll the whole strip — jump instead.
    const step = (delta: number) => {
      const next = wrap(index + delta);
      const wrapped = next !== index + delta;
      goTo(next, wrapped ? "auto" : behavior());
    };

    // Synchronous on purpose: rAF stalls while the page isn't being painted,
    // which would leave the caption stale after a Tab-driven scroll.
    track.addEventListener(
      "scroll",
      () => {
        if (settleTimer || viewer.open) return;
        const i = indexFromScroll();
        if (i !== index) setIndex(i);
      },
      { passive: true },
    );

    document.getElementById("shots-prev")?.addEventListener("click", () => step(-1));
    document.getElementById("shots-next")?.addEventListener("click", () => step(1));
    thumbs.forEach((t, i) => t.addEventListener("click", () => goTo(i)));

    // ---- Full-screen viewer -------------------------------------------------
    /** Same derivatives as the stage, but `sizes="100vw"` lets the browser pick a bigger one. */
    const asViewerCandidate = (from: HTMLImageElement) => {
      const img = new Image();
      img.sizes = "100vw";
      img.srcset = from.srcset;
      img.src = from.src;
      return img;
    };

    let syncToken = 0;
    const syncViewer = () => {
      // Pin the shot this call is for: `index` moves on, and a swap that lands
      // late must know whether it is still the one being asked for.
      const shot = index;
      const from = stageImgs[shot];
      viewerCaption.textContent = captions[shot];
      viewerCounter.textContent = `${shot + 1} / ${total}`;
      resetZoom(false);

      // Bumped even when the shot is already up, so pressing next then back
      // before the first swap lands cannot leave the wrong image on screen.
      const token = ++syncToken;
      if (viewerImg.dataset.shot === String(shot)) return;

      const apply = () => {
        if (token !== syncToken) return; // a later press already won the race
        viewerImg.dataset.shot = String(shot);
        viewerImg.srcset = from.srcset;
        viewerImg.src = from.src;
        viewerImg.alt = from.alt;
        prefetch(shot - 1);
        prefetch(shot + 1);
      };

      // The full-screen candidate is a wider derivative than the stage
      // downloaded, so swapping straight away leaves the viewer blank until it
      // arrives. Decode first and the shot changes in one frame. Opening is the
      // exception: there is nothing worth holding on screen, and waiting would
      // only stall the dialog.
      const next = asViewerCandidate(from);
      if (!viewer.open || next.complete) apply();
      else next.decode().then(apply, apply);
    };

    /** Warm the neighbours so arrow presses land instantly. */
    const prefetch = (i: number) => {
      asViewerCandidate(stageImgs[wrap(i)]);
    };

    const openViewer = (i: number) => {
      if (typeof viewer.showModal !== "function") return;
      goTo(i, "auto");
      syncViewer();
      viewer.showModal();
      document.body.style.overflow = "hidden";
    };

    const closeViewer = () => {
      if (viewer.open) viewer.close();
    };

    frames.forEach((frame, i) =>
      frame.addEventListener("click", (e) => {
        // Touch gets the explicit button instead: on a phone this frame is
        // also the swipe surface, so tap-to-enlarge fires on every near-miss.
        // Judge the pointer that actually fired rather than the device, so a
        // touchscreen laptop still enlarges when the mouse is the one clicking.
        // `click` is only a PointerEvent from Safari 13 on — older engines fall
        // back to asking whether this device has a pointer that can hover.
        const viaTouch =
          e instanceof PointerEvent ? e.pointerType === "touch" : !finePointer.matches;
        if (!viaTouch) openViewer(i);
      }),
    );
    zoomBtns.forEach((btn, i) =>
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        openViewer(i);
      }),
    );

    document.getElementById("viewer-prev")?.addEventListener("click", () => step(-1));
    document.getElementById("viewer-next")?.addEventListener("click", () => step(1));
    document.getElementById("viewer-close")?.addEventListener("click", closeViewer);

    // Clicking the dimmed area around the image closes, like every other viewer.
    viewer.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target === viewer || target.classList.contains("viewer-inner")) closeViewer();
    });

    viewer.addEventListener("close", () => {
      document.body.style.overflow = "";
      resetZoom(false);
      holdStage("auto");
      centerIn(track, slides[index], "auto");
      zoomBtns[index]?.focus({ preventScroll: true });
    });

    document.addEventListener("keydown", (e) => {
      if (!viewer.open || e.altKey || e.ctrlKey || e.metaKey) return;
      if (e.key === "ArrowLeft") step(-1);
      else if (e.key === "ArrowRight") step(1);
      else if (e.key === "Home") goTo(0, "auto");
      else if (e.key === "End") goTo(total - 1, "auto");
      // The dialog closes itself on Esc, but only from a real key press — do it
      // here too so the shortcut never depends on the UA's close watcher.
      else if (e.key === "Escape") closeViewer();
      else return;
      e.preventDefault();
    });

    // ---- Pinch-zoom, pan and swipe -----------------------------------------
    // One rule decides everything: at 1× a drag is a swipe between shots, and
    // any closer than that a drag pans the shot you are looking at. Zooming in
    // and then losing the frame to a swipe was the whole complaint.
    const MAX_SCALE = 4;
    const DOUBLE_TAP_SCALE = 2.5;
    const SWIPE_PX = 45;
    const TAP_SLOP_PX = 8;

    let scale = 1;
    let tx = 0;
    let ty = 0;
    let dragX = 0; // rubber-band give while swiping at 1×

    const draw = (animate: boolean) => {
      viewerImg.style.transition = animate && !reduced.matches ? "transform 0.2s ease-out" : "none";
      viewerImg.style.transform = `translate(${tx + dragX}px, ${ty}px) scale(${scale})`;
      viewerStage.classList.toggle("is-zoomed", scale > 1.01);
    };

    function resetZoom(animate: boolean) {
      scale = 1;
      tx = 0;
      ty = 0;
      dragX = 0;
      draw(animate);
    }

    /** Never let the panned image pull away from the frame it fills. */
    const clampPan = () => {
      const maxX = Math.max(0, (viewerImg.offsetWidth * scale - viewerStage.clientWidth) / 2);
      const maxY = Math.max(0, (viewerImg.offsetHeight * scale - viewerStage.clientHeight) / 2);
      tx = clamp(tx, -maxX, maxX);
      ty = clamp(ty, -maxY, maxY);
    };

    const stageCentre = () => {
      const r = viewerStage.getBoundingClientRect();
      return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
    };

    /** Scale to `s` keeping whatever pixel sits under (x, y) exactly there. */
    const zoomAbout = (s: number, x: number, y: number, animate: boolean) => {
      const next = clamp(s, 1, MAX_SCALE);
      const c = stageCentre();
      const k = next / scale;
      tx = x - c.x - k * (x - c.x - tx);
      ty = y - c.y - k * (y - c.y - ty);
      scale = next;
      if (scale <= 1.01) resetZoom(animate);
      else {
        clampPan();
        draw(animate);
      }
    };

    const points = new Map<number, { x: number; y: number }>();
    let pinch: { dist: number; scale: number; x: number; y: number; tx: number; ty: number; cx: number; cy: number } | null =
      null;
    let drag: { x: number; y: number; tx: number; ty: number; moved: boolean; touch: boolean } | null = null;
    let lastTap = 0;

    /** Midpoint and separation of the two active pointers. */
    const spread = () => {
      const [a, b] = Array.from(points.values());
      return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2, d: Math.max(1, Math.hypot(a.x - b.x, a.y - b.y)) };
    };

    const beginPinch = () => {
      const s = spread();
      const c = stageCentre();
      pinch = { dist: s.d, scale, x: s.x, y: s.y, tx, ty, cx: c.x, cy: c.y };
      drag = null;
      lastTap = 0;
    };

    viewerStage.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse" && e.button !== 0) return;
      viewerStage.setPointerCapture(e.pointerId);
      points.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (points.size === 2) beginPinch();
      else if (points.size === 1) {
        drag = { x: e.clientX, y: e.clientY, tx, ty, moved: false, touch: e.pointerType !== "mouse" };
      }
    });

    viewerStage.addEventListener("pointermove", (e) => {
      const p = points.get(e.pointerId);
      if (!p) return;
      p.x = e.clientX;
      p.y = e.clientY;

      if (pinch && points.size >= 2) {
        const s = spread();
        const next = clamp((s.d / pinch.dist) * pinch.scale, 1, MAX_SCALE);
        const k = next / pinch.scale;
        // Anchor the pixel under the first midpoint, then follow the fingers.
        tx = s.x - pinch.cx - k * (pinch.x - pinch.cx - pinch.tx);
        ty = s.y - pinch.cy - k * (pinch.y - pinch.cy - pinch.ty);
        scale = next;
        clampPan();
        draw(false);
        return;
      }

      if (!drag) return;
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;
      if (!drag.moved && Math.hypot(dx, dy) > TAP_SLOP_PX) {
        drag.moved = true;
        lastTap = 0; // a drag in between must not pair up two stray taps
      }
      if (!drag.moved) return;

      if (scale > 1.01) {
        tx = drag.tx + dx;
        ty = drag.ty + dy;
        clampPan();
        draw(false);
      } else if (drag.touch) {
        dragX = dx * 0.35;
        draw(false);
      }
    });

    const endPointer = (e: PointerEvent) => {
      if (!points.has(e.pointerId)) return;
      points.delete(e.pointerId);
      if (viewerStage.hasPointerCapture(e.pointerId)) viewerStage.releasePointerCapture(e.pointerId);

      if (pinch && points.size < 2) {
        pinch = null;
        if (scale <= 1.01) resetZoom(true);
        else {
          clampPan();
          draw(true);
        }
        // Hand the surviving finger a fresh origin so the shot does not jump.
        const rest = Array.from(points.values())[0];
        if (rest) drag = { x: rest.x, y: rest.y, tx, ty, moved: true, touch: true };
        return;
      }

      if (points.size > 0 || !drag) return;
      const started = drag;
      drag = null;

      // Taps are read before the pan release, so a double tap still zooms back
      // out while the shot is enlarged — which is the only time you want it.
      if (!started.moved) {
        dragX = 0;
        if (e.timeStamp - lastTap < 320) {
          lastTap = 0;
          zoomAbout(scale > 1.01 ? 1 : DOUBLE_TAP_SCALE, e.clientX, e.clientY, true);
        } else {
          lastTap = e.timeStamp;
          draw(false);
        }
        return;
      }

      if (scale > 1.01) {
        clampPan();
        draw(true);
        return;
      }

      dragX = 0;
      const dx = e.clientX - started.x;
      const dy = e.clientY - started.y;
      if (started.touch && Math.abs(dx) > SWIPE_PX && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
      else draw(true);
    };

    viewerStage.addEventListener("pointerup", endPointer);
    viewerStage.addEventListener("pointercancel", endPointer);
    // A zoomed shot that survived a rotate or a keyboard would sit off-centre.
    window.addEventListener("resize", () => {
      if (viewer.open && scale > 1.01) {
        clampPan();
        draw(false);
      }
    });
  }
</script>
