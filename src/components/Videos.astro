---
/**
 * Home-page video gallery, under the screenshots: the two trailers and the short clips
 * from the Steam page.
 *
 * Each card is a plain link to the video on YouTube with a poster kept in this repo, so
 * the page asks YouTube for nothing until someone presses play. The hero's script picks
 * every card up through its `data-video-id` and plays it in the theater on the page.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import { VIDEOS } from "../data/videos";

const modules = import.meta.glob<ImageMetadata>("../../videos/*.jpg", {
  eager: true,
  import: "default",
});
const byFile: Record<string, ImageMetadata> = {};
for (const [p, img] of Object.entries(modules)) {
  const file = p.split("/").pop();
  if (file) byFile[file] = img;
}

const videos = VIDEOS.map((v) => {
  const img = byFile[v.poster];
  if (!img) throw new Error(`Video poster "${v.poster}" is listed in src/data/videos.ts but missing from videos/`);
  return { ...v, img };
});

// Four cards across at full width, down to one on a phone.
const CARD_WIDTHS = [320, 480, 640];
const CARD_SIZES = "(max-width: 560px) 100vw, (max-width: 900px) 50vw, 284px";
---

<section class="section videos" id="videos" aria-labelledby="videos-title">
  <div class="wrap">
    <header class="videos-head" data-reveal>
      <h2 id="videos-title">Videos</h2>
    </header>

    <ul class="videos-grid" data-reveal style="--reveal-delay: 90ms">
      {
        videos.map((v) => (
          <li>
            <a
              class="video-card"
              href={`https://www.youtube.com/watch?v=${v.id}`}
              data-video-id={v.id}
              data-video-next={v.next}
              target="_blank"
              rel="noopener"
              aria-label={`Play video: ${v.title}`}
            >
              <span class="video-poster">
                <Image
                  src={v.img}
                  alt=""
                  class="video-img"
                  widths={CARD_WIDTHS}
                  sizes={CARD_SIZES}
                  loading="lazy"
                  decoding="async"
                />
                <span class="video-play" aria-hidden="true">
                  <Icon name="play" size={26} />
                </span>
              </span>
              <span class="video-title">{v.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .videos-head {
    text-align: center;
    margin-bottom: clamp(1.4rem, 3vw, 2.2rem);
  }
  .videos-head h2 {
    font-size: clamp(1.7rem, 1.2rem + 1.6vw, 2.4rem);
  }
  .videos-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.9rem, 2vw, 1.4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 900px) {
    .videos-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .videos-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .video-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--st-radius);
    overflow: hidden;
    background: var(--st-surface);
    border: 1px solid var(--st-border);
    box-shadow: var(--st-shadow);
    color: var(--st-ink);
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  .video-card:hover,
  .video-card:focus-visible {
    transform: translateY(-3px);
    border-color: var(--st-green);
    background: var(--st-surface-hover);
  }
  .video-poster {
    position: relative;
    display: block;
    line-height: 0;
    background: #0b0d08;
  }
  .video-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border: 1px solid rgba(244, 239, 225, 0.22);
    border-radius: 50%;
    background: rgba(8, 10, 6, 0.66);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    color: var(--st-ink);
    transform: translate(-50%, -50%);
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }
  .video-card:hover .video-play,
  .video-card:focus-visible .video-play {
    background: var(--st-cta);
    color: var(--st-cta-ink);
    transform: translate(-50%, -50%) scale(1.08);
  }
  .video-title {
    padding: 0.75rem 0.9rem 0.85rem;
    font-weight: 700;
    line-height: 1.3;
  }
  @media (prefers-reduced-motion: reduce) {
    .video-card,
    .video-play {
      transition: none;
    }
    .video-card:hover,
    .video-card:focus-visible {
      transform: none;
    }
  }
</style>
