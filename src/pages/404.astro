---
/**
 * Custom 404. Astro emits this as `dist/404.html`, which GitHub Pages serves
 * for any unknown path on the custom domain.
 */
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import background from "../../logos/st2_background_1920x1080.png";

const routes = [
  { href: "/terrains", label: "Community Terrains", icon: "grid", blurb: "Browse and download community maps." },
  { href: "/farms", label: "Farms", icon: "home", blurb: "Every farm the Sheep can build." },
  { href: "/submit", label: "Share a Terrain", icon: "upload", blurb: "Send us a map you made." },
];
---

<BaseLayout
  title="404 — This Sheep Wandered Off | Sheep Tag 2"
  description="That page has strayed outside the fence. Head back to the pasture."
  noindex={true}
>
  <section class="lost">
    <Image src={background} alt="" class="lost-bg" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" />
    <div class="lost-scrim" aria-hidden="true"></div>

    <div class="wrap lost-content">
      <span class="visually-hidden">Error 404 — page not found.</span>
      <p class="lost-code" aria-hidden="true">
        <span>4</span><span class="lost-sheep">🐑</span><span>4</span>
      </p>
      <h1>This sheep wandered off.</h1>
      <p class="lost-sub">
        There's nothing at <code class="lost-path" id="lost-path">this address</code> &mdash; the page
        moved, the link went stale, or a Wolf got to it first. Best head back inside the fence.
      </p>

      <div class="lost-ctas">
        <a class="btn btn--primary" href="/">
          <Icon name="home" size={18} /> Back to the pasture
        </a>
      </div>

      <ul class="lost-routes">
        {
          routes.map((r) => (
            <li>
              <a href={r.href} class="lost-route card">
                <span class="lost-route-ico"><Icon name={r.icon} size={20} /></span>
                <span class="lost-route-body">
                  <span class="lost-route-name">{r.label}</span>
                  <span class="lost-route-blurb">{r.blurb}</span>
                </span>
                <Icon name="chevronRight" size={18} class="lost-route-go" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    position: relative;
    margin-top: calc(-1 * var(--st-header-h));
    min-height: 100svh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .lost-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% center;
    z-index: -2;
    filter: saturate(0.75) blur(2px);
    transform: scale(1.04); /* hides the blur's soft edges */
  }
  .lost-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(90% 70% at 50% 45%, rgba(8, 10, 6, 0.55), rgba(8, 10, 6, 0.9) 70%),
      linear-gradient(to top, rgba(8, 10, 6, 0.9), transparent 55%);
  }
  .lost-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.85rem;
    padding-top: calc(var(--st-header-h) + 4vh);
    padding-bottom: 6vh;
  }

  .lost-code {
    display: flex;
    align-items: center;
    gap: 0.05em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(4.5rem, 3rem + 12vw, 11rem);
    line-height: 0.9;
    color: var(--st-gold);
    text-shadow:
      0 4px 0 var(--st-gold-deep),
      0 10px 30px rgba(0, 0, 0, 0.6);
  }
  .lost-sheep {
    font-size: 0.78em;
    /* Emoji shouldn't take the gold text-shadow — it muddies the glyph. */
    text-shadow: 0 8px 22px rgba(0, 0, 0, 0.55);
    transform-origin: 50% 80%;
  }

  .lost h1 {
    font-size: clamp(1.5rem, 1.1rem + 2vw, 2.4rem);
    text-wrap: balance;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8);
  }
  .lost-sub {
    max-width: 60ch;
    color: var(--st-ink-muted);
    text-wrap: pretty;
  }
  .lost-path {
    font-size: 0.92em;
    padding: 0.12em 0.45em;
    border-radius: 6px;
    background: rgba(8, 10, 6, 0.6);
    border: 1px solid var(--st-border);
    color: var(--st-ink);
    word-break: break-all;
  }
  .lost-ctas {
    margin-top: 0.5rem;
  }

  .lost-routes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 0.7rem;
    width: 100%;
    max-width: 820px;
    margin-top: 2.2rem;
    padding: 0;
    list-style: none;
  }
  .lost-route {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    height: 100%;
    padding: 0.85rem 1rem;
    text-align: left;
    text-decoration: none;
    color: var(--st-ink);
    background: color-mix(in srgb, var(--st-surface) 88%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .lost-route:hover {
    color: var(--st-ink);
    transform: translateY(-2px);
    background: var(--st-surface-hover);
  }
  .lost-route-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--st-green-deep) 45%, transparent);
    color: var(--st-green-bright);
  }
  .lost-route-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .lost-route-name {
    font-family: var(--font-display);
    font-weight: 600;
  }
  .lost-route-blurb {
    font-size: 0.85rem;
    color: var(--st-ink-muted);
    line-height: 1.35;
  }
  .lost-route-go {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--st-ink-subtle);
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .lost-route:hover .lost-route-go {
    color: var(--st-green-bright);
    transform: translateX(3px);
  }

  /* The stray sheep keeps grazing its way off the page. */
  @media (prefers-reduced-motion: no-preference) {
    .lost-sheep {
      animation: sheep-wander 5.5s ease-in-out infinite;
    }
    @keyframes sheep-wander {
      0%,
      100% {
        transform: translate(0, 0) rotate(0deg);
      }
      25% {
        transform: translate(0.06em, -0.05em) rotate(-5deg);
      }
      50% {
        transform: translate(0, 0.02em) rotate(0deg);
      }
      75% {
        transform: translate(-0.06em, -0.05em) rotate(5deg);
      }
    }
  }
</style>

<script>
  // Show the address that missed, so the visitor knows what to fix. Written from
  // JS because the page is a single static 404.html served for every bad path.
  const el = document.getElementById("lost-path");
  if (el) el.textContent = location.pathname + location.search;
</script>
