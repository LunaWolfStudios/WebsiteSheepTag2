---
import GuidePage from "../../components/guides/GuidePage.astro";
import Prose from "../../components/guides/Prose.astro";
import EntryGrid from "../../components/guides/EntryGrid.astro";
import SectionLinks from "../../components/guides/SectionLinks.astro";
import { BASIC_ABILITIES, FLOCK_BODY, SHEEP_SPELLS } from "../../data/guides";

// A Sheep's own spells sit on the card beside the basic commands.
const shared = BASIC_ABILITIES.filter((a) => ["Attack", "Stop", "Hold", "Patrol"].includes(a.name));

// The game's own opening is the deck, so the page doesn't say the same thing twice.
const [opening, ...rest] = FLOCK_BODY;
---

<GuidePage
  slug="sheep"
  title="Sheep — Sheep Tag 2 Guides"
  description="Don't get captured. Build farms, use your size, and get your allies out of the pen."
  intro={opening}
  bodyIntro
>
  <Prose body={rest} />

  <EntryGrid
    entries={SHEEP_SPELLS}
    title="Spells"
    icon="AbilityPanel_AbilityIcon_Pressed.png"
    intro="What a Sheep casts beyond the basic commands."
  />

  <EntryGrid
    entries={shared}
    title="Basic Commands"
    intro="The basic commands a Sheep answers to, the same as any unit that can swing."
    dense
  />

  <SectionLinks slugs={["farms", "spells", "wolves"]} />
</GuidePage>
