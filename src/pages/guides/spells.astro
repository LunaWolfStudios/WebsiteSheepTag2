---
import GuidePage from "../../components/guides/GuidePage.astro";
import EntryGrid from "../../components/guides/EntryGrid.astro";
import SectionLinks from "../../components/guides/SectionLinks.astro";
import {
  BASIC_ABILITIES,
  MAGIC_FARM_SPELLS,
  SHEEP_SPELLS,
  SPIRIT_SPELLS,
  WOLF_SPELLS,
} from "../../data/guides";

const standingOrders = BASIC_ABILITIES.filter((a) =>
  ["Attack", "Stop", "Hold", "Patrol"].includes(a.name),
);
---

<GuidePage
  slug="spells"
  title="Spells — Sheep Tag 2 Guides"
  intro="The spells on each command card. Every unit has the basic commands it can use, plus the spells for its role."
>
  <EntryGrid
    entries={standingOrders}
    title="Basic Commands"
    intro="The basic commands on a command card. A Spirit cannot attack, so it has all of these except Attack."
    dense
  />

  <EntryGrid
    entries={SHEEP_SPELLS}
    title="Sheep"
    icon="MultiboardIcon_Sheep.png"
    intro="Find your allies, remove your last farm, reveal invisible Wolves, add armor to nearby farms, and teleport through a farm in your way."
  />

  <EntryGrid
    entries={WOLF_SPELLS}
    title="Wolves"
    icon="MultiboardIcon_Wolf.png"
    intro="Spells to see farther, set traps, find Sheep, and get through farms."
  />

  <EntryGrid
    entries={SPIRIT_SPELLS}
    title="Spirits"
    icon="MultiboardIcon_Spirit.png"
    intro="A Spirit in the pen can still give gold to living allies and see where they are."
  />

  <EntryGrid
    entries={MAGIC_FARM_SPELLS}
    title="Magic Farm"
    icon="Icon_MagicFarm.png"
    intro="The Magic Farm and Tiny Magic Farm are the only farms that cast spells."
  />

  <SectionLinks slugs={["basic-abilities", "potions", "farms"]} />
</GuidePage>
