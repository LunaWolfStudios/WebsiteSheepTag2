---
import GuidePage from "../../components/guides/GuidePage.astro";
import Prose from "../../components/guides/Prose.astro";
import EntryGrid from "../../components/guides/EntryGrid.astro";
import SectionLinks from "../../components/guides/SectionLinks.astro";
import Panel from "../../components/guides/Panel.astro";
import GlyphFlow from "../../components/guides/GlyphFlow.astro";
import { BASIC_ABILITIES, PEN_BODY, SPIRIT_SPELLS } from "../../data/guides";

// A Spirit answers to every basic command but Attack — it has nothing to swing.
const shared = BASIC_ABILITIES.filter((a) => ["Stop", "Hold", "Patrol"].includes(a.name));

// The game's own opening is the deck, so the page doesn't say the same thing twice.
const [opening, ...rest] = PEN_BODY;

// From the capture to the pen and back out again: one attack from a living ally is the rescue.
const rescue = [
  { icon: "MultiboardIcon_KillCapture1.png", alt: "Captured by a Wolf" },
  { icon: "MultiboardIcon_KillCapture2.png", alt: "Held in the pen as a Spirit" },
  { icon: "MultiboardIcon_SavesRevive.png", alt: "A living Sheep attacks it" },
  { icon: "MultiboardIcon_Sheep.png", alt: "Back in the round" },
];
---

<GuidePage
  slug="spirits"
  title="Spirits — Sheep Tag 2 Guides"
  description="Capture is a change of role, not the end of the round. A Spirit waits in the pen for an ally's swing."
  intro={opening}
  bodyIntro
>
  <Prose body={rest} />

  <Panel title="How a save works" center>
    <GlyphFlow steps={rescue} size={56} />
  </Panel>

  <EntryGrid
    entries={SPIRIT_SPELLS}
    title="Spells"
    icon="AbilityPanel_AbilityIcon_Pressed.png"
    intro="A Spirit still carries a command card, so it can keep helping the flock from the pen."
  />

  <EntryGrid
    entries={shared}
    title="Basic Commands"
    intro="A Spirit has nothing to swing, so it carries the movement commands and not Attack."
    dense
  />

  <SectionLinks slugs={["sheep", "game-modes"]} />
</GuidePage>
