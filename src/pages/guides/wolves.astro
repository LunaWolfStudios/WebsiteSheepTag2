---
import GuidePage from "../../components/guides/GuidePage.astro";
import Prose from "../../components/guides/Prose.astro";
import EntryGrid from "../../components/guides/EntryGrid.astro";
import SectionLinks from "../../components/guides/SectionLinks.astro";
import { BASIC_ABILITIES, PACK_BODY, WOLF_SPELLS } from "../../data/guides";

const shared = BASIC_ABILITIES.filter((a) => ["Attack", "Stop", "Hold", "Patrol"].includes(a.name));

// The game's own opening is the deck, so the page doesn't say the same thing twice.
const [opening, ...rest] = PACK_BODY;
---

<GuidePage
  slug="wolves"
  title="Wolves — Sheep Tag 2 Guides"
  description="Corner the Sheep. Trade gold for permanent power, and go through the walls the flock builds."
  intro={opening}
  bodyIntro
>
  <Prose body={rest} />

  <EntryGrid
    entries={WOLF_SPELLS}
    title="Spells"
    icon="AbilityPanel_AbilityIcon_Pressed.png"
    intro="What a Wolf casts beyond the basic commands."
  />

  <EntryGrid
    entries={shared}
    title="Basic Commands"
    intro="The basic commands a Wolf answers to, the same as any unit that can swing."
    dense
  />

  <SectionLinks slugs={["potions", "upgrades", "spirits"]} />
</GuidePage>
